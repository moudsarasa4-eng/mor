# Copiá a .env y ajustá. Todas son opcionales (tienen default para desarrollo).

# Clave para firmar los tokens JWT. Si NO la seteás, se genera una aleatoria por
# proceso y los tokens se invalidan al reiniciar (el dashboard muestra "sesión
# vencida"). Para producción, poné una fija y secreta.
EOS_SECRET_KEY=

# Usuario y contraseña iniciales (se crean en la primera corrida).
EOS_USER=marco
EOS_PASSWORD=electricista

# Base de datos (por defecto SQLite en ./eos.db).
# EOS_DATABASE_URL=sqlite:///./eos.db

# Horas de validez del token (default 12).
# EOS_TOKEN_HORAS=12
